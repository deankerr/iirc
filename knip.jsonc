{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // The tsconfig plugin name is served by @effect/tsgo, not its own package.
  "ignoreDependencies": ["@effect/language-service"],
  "workspaces": {
    // Spawned by path from the kill tests, so nothing imports it.
    "packages/log": { "entry": ["src/recording-child.ts"] },
  },
}
