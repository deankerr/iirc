{
  "name": "iirc",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/atom-react": "4.1.1",
      "@effect/platform-bun": "4.1.1",
      "@effect/sql-sqlite-bun": "4.1.1",
      "effect": "4.1.1",
      "vitest": "5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "iirc": "bun apps/iirc/src/main.ts",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepare": "effect-tsgo patch --oxlint && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "test": "bun --bun vitest run",
    "e2e": "bun run --filter @iirc/daemon e2e && bun run --filter iirc e2e",
    "build:web": "bun run --filter @iirc/web build",
    "build:iirc": "bun run build:web && bun apps/iirc/build.ts",
    "build:iirc:no-web": "bun apps/iirc/build.ts --no-web"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@types/bun": "1.4.4",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "6.44.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "ultracite": "8.1.0",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "bun@1.4.4"
}
