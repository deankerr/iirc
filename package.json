{
  "name": "iirc",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@effect/platform-bun": "4.1.1",
      "@effect/sql-sqlite-bun": "4.1.1",
      "@effect/vitest": "4.1.1",
      "effect": "4.1.1",
      "vitest": "5.0.5"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --filter @iirc/app --filter @iirc/soak build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "knip": "knip",
    "prepare": "effect-tsgo patch --oxlint && if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "proof:floor": "bun run build && bun apps/iirc/src/floor-proof.ts",
    "test": "bun run --parallel --filter '*' test"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@types/bun": "1.4.4",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "knip": "6.44.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.74.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "ultracite": "8.1.0"
  },
  "engines": {
    "bun": "1.4.4",
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "bun@1.4.4"
}
