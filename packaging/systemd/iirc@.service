# The iirc Daemon as a systemd user service (RUN-1). It is a template, so one machine can
# run several Daemons: instance `x` keeps its Log in ~/.local/state/iirc/x and reads its
# environment, such as IIRC_HTTP_PORT, from ~/.config/iirc/x.env.
# docs/guides/running.md says how to install it.

[Unit]
Description=iirc Daemon (%i)

[Service]
Type=exec
ExecStart=%h/.local/bin/iirc daemon
Environment=IIRC_DATA_DIR=%S/iirc/%i
EnvironmentFile=%E/iirc/%i.env

# The Log, its lock, Credentials kept in a file, and backups, all readable by the Owner
# alone.
StateDirectory=iirc/%i
StateDirectoryMode=0700
UMask=0077

# Backoff lives in the Log (LIVE-4), so a crash loop here cannot hammer a Network.
Restart=on-failure
RestartSec=2

# SIGTERM is a clean stop that exits 0 (RUN-3). The longest one waits up to 10 seconds
# for each Network's QUIT, and about 3 more for reads in flight, so 30 leaves room.
KillSignal=SIGTERM
TimeoutStopSec=30

# Everything but its own state is read-only, and it sees no devices, kernel knobs, or
# other users' /tmp. The JIT needs memory that is writable and executable, so
# MemoryDenyWriteExecute stays off. A user manager does this through a user namespace.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# AF_UNIX reaches the keyring over D-Bus, and AF_NETLINK is how name lookups see which
# addresses this machine has.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
