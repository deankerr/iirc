# The sending half of the soak test (PROOF-5): one counted Message to each pair, from a
# timer every minute. It reads the Daemon's URL, key, and pairs from ~/.config/iirc/soak.env,
# which is never committed. docs/guides/soak.md says how to set it up.
#
# The binary is a pinned copy, so that a day-to-day build never replaces it under the soak.

[Unit]
Description=iirc soak test: send the next counted Message

[Service]
Type=oneshot
EnvironmentFile=%E/iirc/soak.env
# `${…}` is one argument whatever it holds, and `$…` is split at spaces, which is how one
# variable carries several `--pair` flags. IIRC_KEY, the sender's key, is read from the
# environment by the program itself, so that it never shows in `ps`.
ExecStart=%h/.local/opt/iirc/soak/iirc-soak send --daemon ${SOAK_SENDER_URL} $SOAK_SEND_PAIRS

# Ends a hung run before the next minute's, which a oneshot unit would otherwise hold off.
TimeoutStartSec=50

# It writes nothing at all, and sees nothing of the machine but the network.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077
# AF_NETLINK is how name lookups see which addresses this machine has.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
