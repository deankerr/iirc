# The checking half of the soak test (PROOF-5). It keeps no state: each run reads both
# Daemons' Logs in full and judges them again, prints a line for each pair to the journal,
# and adds a line of JSON to the report. It exits non-zero on anything unexplained, so the
# unit shows as failed. docs/soak.md says how to read it.
#
# Its URLs, keys, and pairs come from ~/.config/iirc/soak.env, which is never committed.

[Unit]
Description=iirc soak test: check that no counted Message is missing

[Service]
Type=oneshot
EnvironmentFile=%E/iirc/soak.env
# The report lives in the state directory, ~/.local/state/iirc/soak/report.jsonl.
StateDirectory=iirc/soak
StateDirectoryMode=0700
ExecStart=%h/.local/opt/iirc/soak/iirc-soak check --sender ${SOAK_SENDER_URL} --receiver ${SOAK_RECEIVER_URL} --report %S/iirc/soak/report.jsonl $SOAK_CHECK_PAIRS

# Reading a month of Log takes seconds. This ends a Daemon that stopped answering.
TimeoutStartSec=600

# Everything but the report is read-only, and it sees nothing of the machine but the
# network.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
UMask=0077
# AF_NETLINK is how name lookups see which addresses this machine has.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
