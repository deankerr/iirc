# Every hour, and once shortly after the user manager starts, which is after a reboot
# for a user with lingering on. The run after a start shows whether the Daemons came back
# and were explained by their Gaps (PROOF-5).

[Unit]
Description=iirc soak test: check hourly, and soon after a start

[Timer]
OnCalendar=hourly
OnStartupSec=5min
# A run that fell due while the machine was off happens when it is back.
Persistent=true
AccuracySec=1s

[Install]
WantedBy=timers.target
